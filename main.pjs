// ---- Hall of Fates: procedural atlas for the nested-plugin explorer (Help modal) ----
// Generative flavor only: every visit unfolds a different corner of the multiverse.
atlasRoot
  n = {5-5}
  name = Hall of Fates
  description = Every visit unfolds a different corner of the multiverse. Click to explore.
  atlas_gilded {1-1}
  atlas_ruin {1-1}
  atlas_wild {1-1}
  atlas_omen {1-1}
  atlas_tide {1-1}

atlas_gilded
  n = {2-2}
  name = Gilded Reaches
  description = Kingdoms where the roofs are gold and the debts are golden too.
  marble_court {1-1}
  harbor_lights {1-1}

marble_court
  description = A court of white stone where every whisper is a treaty and every treaty has a footnote.

harbor_lights
  description = Lanterns on black water. Ships leave full and return full of stories.

atlas_ruin
  n = {2-2}
  name = Quiet Ruins
  description = Empires that kept perfect records of their own endings.
  sunken_library {1-1}
  hollow_tower {1-1}

sunken_library
  description = Shelves below the tideline. The books are dry; nobody knows why.

hollow_tower
  description = A lighthouse with no lamp. Sailors steer by the absence.

atlas_wild
  n = {2-2}
  name = Unmapped Wilds
  description = The map ends here. The pencils are nervous.
  whispering_steppe {1-1}
  glass_desert {1-1}

whispering_steppe
  description = Grass that repeats the last thing you said, slightly kinder.

glass_desert
  description = A desert of fulgurite and old lightning. Bring soft shoes.

atlas_omen
  n = {2-2}
  name = Omens & Oracles
  description = Futures sold by weight. No refunds, no exchanges, no eye contact.
  coin_oracle {1-1}
  moth_archive {1-1}

coin_oracle
  description = She flips one coin and reads both sides. Both sides are yours.

moth_archive
  description = Every unwritten letter ends up here, filed under almost.

atlas_tide
  n = {2-2}
  name = Far Tides
  description = Islands that only exist between one census and the next.
  salt_village {1-1}
  drowned_bell {1-1}

salt_village
  description = Houses of pressed salt. It rains once a decade and everyone moves.

drowned_bell
  description = It rings for storms a week early. The village trusts it completely.
