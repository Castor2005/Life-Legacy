// Life & Legacy - Life Simulator (v0.1.03.008)
// Lists used by the game for random names (also duplicated in JS as fallback)

generateText = {import:ai-text-plugin}
generateImage = {import:text-to-image-plugin}
generateImageAdv = {import:advanced-text-to-image-plugin}
kv = {import:kv-plugin}
favicon = {import:favicon-plugin}
remember = {import:remember-plugin}
superFetch = {import:super-fetch-plugin}
dynamicImport = {import:dynamic-import-plugin}
mermaid = {import:mermaid-graph-plugin}
nestedAtlas = {import:nested-plugin}

$meta
  title = Life & Legacy — Life Simulator
  description = Live a life, found a dynasty: traits, prestige, feasts, schemes & heirs meet school, careers, love, crime & fame — with an AI biographer and photorealistic AI portraits. 7 save slots, autosave, download/import lives.
  image = https://user.uploads.dev/file/4c0fbe4483ca65fe3d7fafee247811e6.png
  icon = https://user.uploads.dev/file/d4659a7a90b9af4a59527380632bf03f.png
  header
    mode = minimal

