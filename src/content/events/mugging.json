{
 "id": "mugging",
 "minAge": 14,
 "maxAge": 70,
 "title": "Dark alley",
 "tags": [
  "family",
  "money"
 ],
 "weight": 1,
 "preconditions": null,
 "text": "A figure steps out: 'Wallet. Now.'",
 "choices": [
  {
   "label": "Hand it over",
   "hint": "safe",
   "effects": [
    {
     "op": "let",
     "name": "l",
     "expr": "min(s.money,300)"
    },
    {
     "op": "money",
     "amount": "-(l)"
    },
    {
     "op": "stat",
     "key": "happiness",
     "delta": "-(6)"
    },
    {
     "op": "outcome",
     "tpl": "You lose ${{l}}. Shaken, alive. That's what matters."
    }
   ]
  },
  {
   "label": "Fight! (fitness check)",
   "hint": "risky",
   "effects": [
    {
     "op": "branch",
     "cond": {
      "all": [
       {
        "p": "stats.fitness",
        "gt": 60
       },
       {
        "expr": "rnd()<0.6"
       }
      ]
     },
     "then": [
      {
       "op": "stat",
       "key": "karma",
       "delta": "5"
      },
      {
       "op": "outcome",
       "tpl": "Training pays! They flee. You shake for an hour."
      }
     ],
     "else": [
      {
       "op": "let",
       "name": "l",
       "expr": "min(s.money,500)"
      },
      {
       "op": "money",
       "amount": "-(l)"
      },
      {
       "op": "stat",
       "key": "health",
       "delta": "-(20)"
      },
      {
       "op": "outcome",
       "tpl": "Beaten and robbed (${{l}}). Hospital visit."
      }
     ]
    }
   ]
  },
  {
   "label": "Sprint away",
   "hint": "fitness",
   "effects": [
    {
     "op": "branch",
     "cond": {
      "p": "stats.fitness",
      "gt": 40
     },
     "then": [
      {
       "op": "outcome",
       "tpl": "Gone like wind. Adrenaline for days."
      }
     ],
     "else": [
      {
       "op": "money",
       "amount": "-(300)"
      },
      {
       "op": "stat",
       "key": "health",
       "delta": "-(8)"
      },
      {
       "op": "outcome",
       "tpl": "Caught, shoved, robbed $300."
      }
     ]
    }
   ]
  }
 ]
}