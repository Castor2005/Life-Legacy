{
 "id": "essay-contest",
 "minAge": 14,
 "maxAge": 17,
 "title": "$1,000 essay",
 "tags": [
  "teen",
  "money"
 ],
 "weight": 1,
 "preconditions": null,
 "text": "Scholarship essay for {{s.firstName}}: What home means to me. Deadline Sunday.",
 "choices": [
  {
   "label": "Bleed onto the page",
   "hint": "discipline check",
   "effects": [
    {
     "op": "branch",
     "cond": {
      "p": "stats.discipline",
      "gt": 50
     },
     "then": [
      {
       "op": "money",
       "amount": "1000"
      },
      {
       "op": "stat",
       "key": "happiness",
       "delta": "10"
      },
      {
       "op": "outcome",
       "tpl": "Your essay makes a judge cry. $1,000!"
      }
     ],
     "else": [
      {
       "op": "set",
       "path": "education.grades",
       "value": "clamp(s.education.grades+3)"
      },
      {
       "op": "outcome",
       "tpl": "No win, but the writing muscles grow."
      }
     ]
    }
   ]
  },
  {
   "label": "Copy from the internet",
   "hint": "risky",
   "effects": [
    {
     "op": "chance",
     "p": "0.5",
     "then": [
      {
       "op": "money",
       "amount": "1000"
      },
      {
       "op": "outcome",
       "tpl": "Nobody checks. The money spends fine; sleep does not."
      }
     ],
     "else": [
      {
       "op": "set",
       "path": "education.grades",
       "value": "clamp(s.education.grades-12)"
      },
      {
       "op": "stat",
       "key": "discipline",
       "delta": "-(8)"
      },
      {
       "op": "outcome",
       "tpl": "Plagiarism hearing. Zero, shame, lesson."
      }
     ]
    }
   ]
  }
 ]
}