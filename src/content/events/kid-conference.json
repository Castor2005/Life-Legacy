{
 "id": "kid-conference",
 "minAge": 20,
 "maxAge": 60,
 "title": "Parent-teacher conference",
 "tags": [
  "adult-life",
  "family",
  "money"
 ],
 "weight": 1,
 "preconditions": {
  "some": {
   "arr": "relationships.children",
   "where": {
    "all": [
     {
      "p": "$it.age",
      "gte": 6
     },
     {
      "p": "$it.age",
      "lte": 12
     }
    ]
   }
  }
 },
 "text": {
  "lets": [
   {
    "name": "k",
    "expr": "where(whereAll(s.relationships.children||[],\"age\",\"gte\",6),\"age\",\"lte\",12)"
   }
  ],
  "template": "Ms. Alvarez folds her hands. 'Let's talk about {{k?k.name:\"your child\"}} — grades {{k?k.grades:60}}, conduct '+(k&&k.trouble>3?'...lively':'a delight')+'.'"
 },
 "choices": [
  {
   "label": "Beam with pride",
   "hint": "rel+",
   "effects": [
    {
     "op": "let",
     "name": "k",
     "expr": "where(whereAll(s.relationships.children,\"age\",\"gte\",6),\"age\",\"lte\",12)"
    },
    {
     "op": "branch",
     "cond": {
      "v": "k",
      "truthy": true
     },
     "then": [
      {
       "op": "setv",
       "target": "k",
       "path": "rel",
       "value": "clamp(k.rel+6)"
      }
     ]
    },
    {
     "op": "stat",
     "key": "happiness",
     "delta": "4"
    },
    {
     "op": "outcome",
     "tpl": "'Keep doing whatever you're doing at home,' she says."
    }
   ]
  },
  {
   "label": "Hire a tutor ($300)",
   "hint": "grades+",
   "effects": [
    {
     "op": "let",
     "name": "k",
     "expr": "where(whereAll(s.relationships.children,\"age\",\"gte\",6),\"age\",\"lte\",12)"
    },
    {
     "op": "branch",
     "cond": {
      "v": "k",
      "truthy": true
     },
     "then": [
      {
       "op": "setv",
       "target": "k",
       "path": "grades",
       "value": "clamp(k.grades+12)"
      }
     ]
    },
    {
     "op": "money",
     "amount": "-(300)",
     "floor": 0
    },
    {
     "op": "outcome",
     "tpl": "Flashcards at breakfast. The curve bends upward."
    }
   ]
  },
  {
   "label": "Lay down the law",
   "hint": "grades+, rel-",
   "effects": [
    {
     "op": "let",
     "name": "k",
     "expr": "where(whereAll(s.relationships.children,\"age\",\"gte\",6),\"age\",\"lte\",12)"
    },
    {
     "op": "branch",
     "cond": {
      "v": "k",
      "truthy": true
     },
     "then": [
      {
       "op": "setv",
       "target": "k",
       "path": "grades",
       "value": "clamp(k.grades+5)"
      },
      {
       "op": "setv",
       "target": "k",
       "path": "rel",
       "value": "clamp(k.rel-4)"
      }
     ]
    },
    {
     "op": "outcome",
     "tpl": "No console till the grades move. They move."
    }
   ]
  }
 ]
}