{
 "id": "ow-leverage-crown",
 "minAge": 22,
 "maxAge": 65,
 "title": "Crown of secrets",
 "tags": [
  "adult-life",
  "sex",
  "ownership",
  "love",
  "money"
 ],
 "weight": 1,
 "preconditions": {
  "all": [
   {
    "p": "sex",
    "truthy": true
   },
   {
    "any": [
     {
      "p": "sex.claims.length",
      "gte": 1
     },
     {
      "p": "sex.leverageOn.length",
      "gte": 1
     }
    ]
   }
  ]
 },
 "text": {
  "lets": [
   {
    "name": "on",
    "expr": "s.sex&&s.sex.leverageOn&&s.sex.leverageOn.length||0"
   },
   {
    "name": "cs",
    "expr": "s.sex&&s.sex.claims&&s.sex.claims.length||0"
   }
  ],
  "template": "You hold dirt on {{on}} soul(s) and own {{cs}} lover(s) body and soul — films, confessions, collar deeds. A fixer offers: turn the secrets into a CROWN (cash + obedience) or burn them all."
 },
 "choices": [
  {
   "label": "Wear the blackmail crown",
   "hint": "$$$ karma- scandal+",
   "effects": [
    {
     "op": "let",
     "name": "pay",
     "expr": "0"
    },
    {
     "op": "call",
     "fn": "own.cashoutLeverage"
    },
    {
     "op": "corr",
     "delta": "10"
    },
    {
     "op": "stat",
     "key": "karma",
     "delta": "-(12)"
    },
    {
     "op": "scandal",
     "delta": "12"
    },
    {
     "op": "stat",
     "key": "happiness",
     "delta": "6"
    },
    {
     "op": "outcome",
     "tpl": "You squeeze every secret till it bleeds — cash floods in, owned lovers obey a little faster knowing the films exist. Blackmail is a crown that cuts. Corruption +10."
    }
   ]
  },
  {
   "label": "Burn it all",
   "hint": "karma+, free them a little",
   "effects": [
    {
     "op": "levOnClear"
    },
    {
     "op": "forClaims",
     "idxAs": "j",
     "body": [
      {
       "op": "claimPath",
       "ref": "$it",
       "path": "levOn",
       "value": "null"
      },
      {
       "op": "claimPath",
       "ref": "$it",
       "path": "obedience",
       "value": "clamp(s.sex.claims[j].obedience-8)"
      }
     ]
    },
    {
     "op": "stat",
     "key": "karma",
     "delta": "14"
    },
    {
     "op": "stat",
     "key": "happiness",
     "delta": "4"
    },
    {
     "op": "branch",
     "cond": {
      "partner": "exists"
     },
     "then": [
      {
       "op": "partnerRel",
       "delta": "8"
      }
     ]
    },
    {
     "op": "outcome",
     "tpl": "Bonfire of tapes and photos. The owned ones weep with relief — and love you a fraction more freely. Karma +14."
    }
   ]
  }
 ]
}