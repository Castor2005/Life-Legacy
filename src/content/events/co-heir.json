{
 "id": "co-heir",
 "minAge": 45,
 "maxAge": 85,
 "title": "Whose name on the door?",
 "tags": [
  "adult-life",
  "company",
  "family",
  "status",
  "money"
 ],
 "weight": 1,
 "preconditions": {
  "all": [
   {
    "p": "company",
    "truthy": true
   },
   {
    "some": {
     "arr": "relationships.children",
     "where": {
      "p": "$it.age",
      "gte": 18
     }
    }
   }
  ]
 },
 "text": {
  "lets": [
   {
    "name": "k",
    "expr": "where(s.relationships.children||[],\"age\",\"gte\",18)"
   }
  ],
  "template": "Lawyers ask the question plainly: who inherits {{s.company.name}}? {{k?k.name+\" (\"+(k.trait||\"capable\")+\") waits in the hall.\":\"The hall is empty.\"}}"
 },
 "choices": [
  {
   "label": "Name the successor",
   "hint": "prestige+",
   "effects": [
    {
     "op": "let",
     "name": "k",
     "expr": "where(s.relationships.children,\"age\",\"gte\",18)"
    },
    {
     "op": "branch",
     "cond": {
      "v": "k",
      "truthy": true
     },
     "then": [
      {
       "op": "setv",
       "target": "k",
       "path": "rel",
       "value": "clamp(k.rel+10)"
      }
     ]
    },
    {
     "op": "set",
     "path": "prestige",
     "value": "s.prestige+(10)"
    },
    {
     "op": "set",
     "path": "company.rep",
     "value": "clamp(s.company.rep+3)"
    },
    {
     "op": "outcome",
     "tpl": "Succession papers signed. The staff stands taller knowing the story continues."
    }
   ]
  },
  {
   "label": "Sell when I die — their problem",
   "hint": "karma-",
   "effects": [
    {
     "op": "stat",
     "key": "karma",
     "delta": "-(4)"
    },
    {
     "op": "money",
     "amount": "1000"
    },
    {
     "op": "outcome",
     "tpl": "Noted: 'liquidate.' The lawyers bill extra for the chill."
    }
   ]
  }
 ]
}