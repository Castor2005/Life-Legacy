{
 "id": "yg-open-mic-standup",
 "minAge": 21,
 "maxAge": 29,
 "title": "Five minutes",
 "tags": [
  "adult-life",
  "creativity"
 ],
 "weight": 1,
 "preconditions": null,
 "text": "Open mic standup. Your set is five minutes of almost-truth.",
 "choices": [
  {
   "label": "Take the stage",
   "hint": "creativity+",
   "effects": [
    {
     "op": "branch",
     "cond": {
      "expr": "s.stats.creativity>50"
     },
     "then": [
      {
       "op": "stat",
       "key": "creativity",
       "delta": "8"
      },
      {
       "op": "outcome",
       "tpl": "Real laughs, twice. The host invites you back."
      }
     ],
     "else": [
      {
       "op": "stat",
       "key": "creativity",
       "delta": "3"
      },
      {
       "op": "outcome",
       "tpl": "Silence, one pity laugh, then a great story. Everyone starts here."
      }
     ]
    }
   ]
  },
  {
   "label": "Write for others",
   "hint": "social+",
   "effects": [
    {
     "op": "stat",
     "key": "social",
     "delta": "5"
    },
    {
     "op": "outcome",
     "tpl": "Your jokes kill in a funnier mouth. Credit and gratitude."
    }
   ]
  }
 ]
}