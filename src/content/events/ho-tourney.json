{
 "id": "ho-tourney",
 "minAge": 18,
 "maxAge": 120,
 "title": "The gilded lists",
 "tags": ["houses", "fame", "fitness"],
 "weight": 1,
 "preconditions": {
  "all": [
   {"p": "houses", "truthy": true},
   {"p": "money", "gte": 500}
  ]
 },
 "text": "The houses hold a tourney — swordplay, horsemanship, archery — and common blood may enter for a fee. The crowd loves an underdog.",
 "choices": [
  {
   "label": "Enter the lists ($500)",
   "hint": "fitness 55+",
   "effects": [
    {"op": "chance", "p": "0.5", "then": [
     {"op": "set", "path": "money", "value": "max(0,s.money-500)"},
     {"op": "set", "path": "fame", "value": "min(100,s.fame+14)"},
     {"op": "set", "path": "prestige", "value": "s.prestige+18"},
     {"op": "outcome", "tpl": "You unhorse a baronet's nephew and the crowd ROARS your name. +14 fame, +18 prestige."}
    ], "else": [
     {"op": "set", "path": "money", "value": "max(0,s.money-500)"},
     {"op": "stat", "key": "health", "delta": "-(10)"},
     {"op": "set", "path": "fame", "value": "min(100,s.fame+3)"},
     {"op": "outcome", "tpl": "You last three bouts and leave with a limp, a story, and the crowd's pity-cheer. +3 fame, −10 health."}
    ]}
   ]
  },
  {
   "label": "Bet from the stands ($1,000)",
   "hint": "risky",
   "effects": [
    {"op": "chance", "p": "0.45", "then": [
     {"op": "let", "name": "g", "expr": "2000+floor(rnd()*2000)"},
     {"op": "set", "path": "money", "value": "s.money+(g)"},
     {"op": "outcome", "tpl": "Your pick takes the wreath! +${{g}} from the bookmakers."}
    ], "else": [
     {"op": "set", "path": "money", "value": "max(0,s.money-1000)"},
     {"op": "outcome", "tpl": "Your champion face-plants in the mud. There goes a thousand."}
    ]}
   ]
  },
  {
   "label": "Just watch",
   "hint": "safe, joy+",
   "effects": [
    {"op": "stat", "key": "happiness", "delta": "6"},
    {"op": "outcome", "tpl": "Pennants, thunder, honeyed nuts. A perfect afternoon with no bruises."}
   ]
  }
 ]
}
