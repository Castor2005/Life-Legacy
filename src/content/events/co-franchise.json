{
 "id": "co-franchise",
 "minAge": 18,
 "maxAge": 75,
 "title": "Franchise fever",
 "tags": [
  "adult-life",
  "company",
  "money"
 ],
 "weight": 1,
 "preconditions": {
  "all": [
   {
    "p": "company",
    "truthy": true
   },
   {
    "p": "company.level",
    "gte": 3
   }
  ]
 },
 "text": "Investors want {{s.company.name}} in every city by spring: big money now, your name on Strangers' work.",
 "choices": [
  {
   "label": "Expand fast",
   "hint": "cash+, risky",
   "effects": [
    {
     "op": "chance",
     "p": "0.6",
     "then": [
      {
       "op": "set",
       "path": "company.cash",
       "value": "s.company.cash+(25000)"
      },
      {
       "op": "set",
       "path": "company.value",
       "value": "round(s.company.value*1.2)"
      },
      {
       "op": "set",
       "path": "company.morale",
       "value": "clamp(s.company.morale-6)"
      },
      {
       "op": "outcome",
       "tpl": "Twelve openings, ten hits. +$25,000, value +20%, headaches included."
      }
     ],
     "else": [
      {
       "op": "set",
       "path": "company.rep",
       "value": "clamp(s.company.rep-10)"
      },
      {
       "op": "outcome",
       "tpl": "Three flagship disasters. The brand limps home."
      }
     ]
    }
   ]
  },
  {
   "label": "Protect the name",
   "hint": "rep+",
   "effects": [
    {
     "op": "set",
     "path": "company.rep",
     "value": "clamp(s.company.rep+6)"
    },
    {
     "op": "outcome",
     "tpl": "Slow and beloved beats fast and infamous."
    }
   ]
  }
 ]
}