{
 "id": "kid-firstday",
 "minAge": 20,
 "maxAge": 60,
 "title": "First day of school",
 "tags": [
  "adult-life",
  "family",
  "money"
 ],
 "weight": 1,
 "preconditions": {
  "some": {
   "arr": "relationships.children",
   "where": {
    "all": [
     {
      "p": "$it.age",
      "gte": 5
     },
     {
      "p": "$it.age",
      "lte": 6
     }
    ]
   }
  }
 },
 "text": {
  "lets": [
   {
    "name": "k",
    "expr": "where(whereAll(s.relationships.children||[],\"age\",\"gte\",5),\"age\",\"lte\",6)"
   }
  ],
  "template": "{{k?k.name+\", backpack bigger than torso, \":\"Someone small \"}}faces the school gates. A {{k&&k.trait?k.trait:\"brave\"}} who dreams of being an {{k&&k.dream?k.dream:\"explorer\"}}."
 },
 "choices": [
  {
   "label": "Walk them in",
   "hint": "rel+",
   "effects": [
    {
     "op": "let",
     "name": "k",
     "expr": "where(whereAll(s.relationships.children,\"age\",\"gte\",5),\"age\",\"lte\",6)"
    },
    {
     "op": "branch",
     "cond": {
      "v": "k",
      "truthy": true
     },
     "then": [
      {
       "op": "setv",
       "target": "k",
       "path": "rel",
       "value": "clamp(k.rel+8)"
      }
     ]
    },
    {
     "op": "stat",
     "key": "happiness",
     "delta": "5"
    },
    {
     "op": "outcome",
     "tpl": "Hand squeezed all the way to the classroom door. Then — gone, grinning."
    }
   ]
  },
  {
   "label": "Work ran late",
   "hint": "rel-, money+",
   "effects": [
    {
     "op": "let",
     "name": "k",
     "expr": "where(whereAll(s.relationships.children,\"age\",\"gte\",5),\"age\",\"lte\",6)"
    },
    {
     "op": "branch",
     "cond": {
      "v": "k",
      "truthy": true
     },
     "then": [
      {
       "op": "setv",
       "target": "k",
       "path": "rel",
       "value": "clamp(k.rel-5)"
      }
     ]
    },
    {
     "op": "money",
     "amount": "200"
    },
    {
     "op": "outcome",
     "tpl": "They walked in alone and were fine. You weren't."
    }
   ]
  }
 ]
}