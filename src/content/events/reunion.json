{
 "id": "reunion",
 "minAge": 30,
 "maxAge": 55,
 "title": "High-school reunion",
 "tags": [
  "adult-life",
  "money"
 ],
 "weight": 1,
 "preconditions": null,
 "text": "Invite: 20-year reunion. Everyone will compare everything.",
 "choices": [
  {
   "label": "Go shine",
   "hint": "stats check",
   "effects": [
    {
     "op": "let",
     "name": "score",
     "expr": "s.money+s.stats.happiness*500"
    },
    {
     "op": "branch",
     "cond": {
      "v": "score",
      "gt": 60000
     },
     "then": [
      {
       "op": "stat",
       "key": "happiness",
       "delta": "10"
      },
      {
       "op": "stat",
       "key": "social",
       "delta": "6"
      },
      {
       "op": "outcome",
       "tpl": "You walk in glowing. The bully asks for a job."
      }
     ],
     "else": [
      {
       "op": "stat",
       "key": "happiness",
       "delta": "-(5)"
      },
      {
       "op": "outcome",
       "tpl": "Awkward small talk. The chicken is dry."
      }
     ]
    }
   ]
  },
  {
   "label": "Skip gracefully",
   "hint": "peace",
   "effects": [
    {
     "op": "stat",
     "key": "happiness",
     "delta": "2"
    },
    {
     "op": "outcome",
     "tpl": "You stalk photos from bed. Best seat."
    }
   ]
  }
 ]
}