{
 "id": "kid-sneak",
 "minAge": 28,
 "maxAge": 60,
 "title": "2am window",
 "tags": [
  "adult-life",
  "family"
 ],
 "weight": 1,
 "preconditions": {
  "some": {
   "arr": "relationships.children",
   "where": {
    "all": [
     {
      "p": "$it.age",
      "gte": 13
     },
     {
      "p": "$it.age",
      "lte": 17
     }
    ]
   }
  }
 },
 "text": {
  "lets": [
   {
    "name": "k",
    "expr": "where(whereAll(s.relationships.children||[],\"age\",\"gte\",13),\"age\",\"lte\",17)"
   }
  ],
  "template": "Floorboard creak. {{k?k.name:\"Your teen\"}} freezes halfway out the window, caught red-handed."
 },
 "choices": [
  {
   "label": "Wait up with cocoa",
   "hint": "rel+, trouble-",
   "effects": [
    {
     "op": "let",
     "name": "k",
     "expr": "where(whereAll(s.relationships.children,\"age\",\"gte\",13),\"age\",\"lte\",17)"
    },
    {
     "op": "branch",
     "cond": {
      "v": "k",
      "truthy": true
     },
     "then": [
      {
       "op": "setv",
       "target": "k",
       "path": "rel",
       "value": "clamp(k.rel+6)"
      },
      {
       "op": "setv",
       "target": "k",
       "path": "trouble",
       "value": "max(0,(k.trouble||0)-2)"
      }
     ]
    },
    {
     "op": "stat",
     "key": "happiness",
     "delta": "2"
    },
    {
     "op": "outcome",
     "tpl": "An hour of honest talk. The window stays shut after that."
    }
   ]
  },
  {
   "label": "Lock it all down",
   "hint": "trouble-, rel--",
   "effects": [
    {
     "op": "let",
     "name": "k",
     "expr": "where(whereAll(s.relationships.children,\"age\",\"gte\",13),\"age\",\"lte\",17)"
    },
    {
     "op": "branch",
     "cond": {
      "v": "k",
      "truthy": true
     },
     "then": [
      {
       "op": "setv",
       "target": "k",
       "path": "trouble",
       "value": "max(0,(k.trouble||0)-3)"
      },
      {
       "op": "setv",
       "target": "k",
       "path": "rel",
       "value": "clamp(k.rel-6)"
      }
     ]
    },
    {
     "op": "outcome",
     "tpl": "Alarms, curfews, checks. Peace through paperwork."
    }
   ]
  }
 ]
}