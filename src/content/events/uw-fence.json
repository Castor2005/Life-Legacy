{
 "id": "uw-fence",
 "minAge": 16,
 "maxAge": 60,
 "title": "The fence has work",
 "tags": [
  "family",
  "underworld",
  "crime",
  "money"
 ],
 "weight": 1,
 "preconditions": {
  "all": [
   {
    "p": "underworld",
    "truthy": true
   },
   {
    "p": "underworld.rep",
    "gt": 0
   }
  ]
 },
 "text": "A fence named {{s.underworld&&s.underworld.crew.length?s.underworld.crew[0].name:\"Sal\"}} offers {{s.firstName}} a quiet job: drive, wait, ask nothing.",
 "choices": [
  {
   "label": "Take the job",
   "hint": "cash, heat+",
   "effects": [
    {
     "op": "let",
     "name": "pay",
     "expr": "300+s.underworld.rank*400+floor(rnd()*300)"
    },
    {
     "op": "money",
     "amount": "pay"
    },
    {
     "op": "set",
     "path": "heat",
     "value": "min(100,(s.heat||0)+8)"
    },
    {
     "op": "set",
     "path": "underworld.rep",
     "value": "s.underworld.rep+(3)"
    },
    {
     "op": "outcome",
     "tpl": "Easy miles, fat envelope: +${{pay}}. Heat ticks up."
    }
   ]
  },
  {
   "label": "Decline politely",
   "hint": "karma+",
   "effects": [
    {
     "op": "stat",
     "key": "karma",
     "delta": "3"
    },
    {
     "op": "set",
     "path": "underworld.rep",
     "value": "max(0,s.underworld.rep-1)"
    },
    {
     "op": "outcome",
     "tpl": "You pass. The fence nods — there's always next time."
    }
   ]
  }
 ]
}