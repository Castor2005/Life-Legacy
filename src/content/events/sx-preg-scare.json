{
 "id": "sx-preg-scare",
 "minAge": 20,
 "maxAge": 42,
 "title": "Late.",
 "tags": [
  "adult-life",
  "sex",
  "love",
  "money"
 ],
 "weight": 1,
 "preconditions": null,
 "text": "Your lover, an adult woman (or you, if you can carry), is two weeks late. The test sits on the sink like a bomb. Protection was {{s.sex&&s.sex.protection===false?\"OFF\":\"on\"}}.",
 "choices": [
  {
   "label": "Raw and ready — keep it",
   "hint": "baby+",
   "effects": [
    {
     "op": "let",
     "name": "n",
     "expr": "s.relationships.partner?s.relationships.partner.name:s.sex.lovers[s.sex.lovers.length-1]||randName()"
    },
    {
     "op": "call",
     "fn": "sex.preg",
     "as": "pr",
     "args": {
      "name": {
       "expr": "n"
      },
      "mult": {
       "expr": "2.5"
      },
      "ctrl": {
       "expr": "null"
      }
     }
    },
    {
     "op": "branch",
     "cond": {
      "expr": "pr.indexOf(\"born\")===0"
     },
     "then": [
      {
       "op": "stat",
       "key": "happiness",
       "delta": "12"
      },
      {
       "op": "outcome",
       "tpl": "Positive. Nine months later {{pr.slice(5)}} screams into the world — conceived in lust, kept in love. Dynasty grows."
      }
     ],
     "else": [
      {
       "op": "pregScares"
      },
      {
       "op": "outcome",
       "tpl": "Negative — this time. You both stare at the stick, strangely disappointed."
      }
     ]
    }
   ]
  },
  {
   "label": "Morning-after + double protection",
   "hint": "control",
   "effects": [
    {
     "op": "money",
     "amount": "-(150)"
    },
    {
     "op": "protection",
     "bool": true
    },
    {
     "op": "stat",
     "key": "happiness",
     "delta": "-(3)"
    },
    {
     "op": "outcome",
     "tpl": "Pharmacy run $150, pills + condoms restocked. No child this year. Control reclaimed."
    }
   ]
  },
  {
   "label": "Pray and ignore",
   "hint": "fate",
   "effects": [
    {
     "op": "let",
     "name": "n3",
     "expr": "s.relationships.partner?s.relationships.partner.name:s.sex.lovers[s.sex.lovers.length-1]||randName()"
    },
    {
     "op": "call",
     "fn": "sex.preg",
     "as": "pr3",
     "args": {
      "name": {
       "expr": "n3"
      },
      "mult": {
       "expr": "1"
      },
      "ctrl": {
       "expr": "null"
      }
     }
    },
    {
     "op": "branch",
     "cond": {
      "expr": "pr3.indexOf(\"born\")===0"
     },
     "then": [
      {
       "op": "outcome",
       "tpl": "You ignore it — and {{pr3.slice(5)}} arrives anyway. Fate fucks back."
      }
     ],
     "else": [
      {
       "op": "pregScares"
      },
      {
       "op": "outcome",
       "tpl": "Lucky. Late stress, not a baby. This time."
      }
     ]
    }
   ]
  }
 ]
}