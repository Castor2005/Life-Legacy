{
 "id": "audition-call",
 "minAge": 15,
 "maxAge": 35,
 "title": "Open auditions!",
 "tags": [
  "family",
  "status",
  "money"
 ],
 "weight": 1,
 "preconditions": null,
 "text": "A casting call for a streaming series — thousands will show. Your traits: {{s.traits||[].join(\", \")||\"none\"}}.",
 "choices": [
  {
   "label": "Audition!",
   "hint": "looks/creativity",
   "effects": [
    {
     "op": "branch",
     "cond": {
      "any": [
       {
        "expr": "s.stats.looks+s.stats.creativity>110"
       },
       {
        "all": [
         {
          "p": "traits",
          "truthy": true
         },
         {
          "expr": "s.traits.includes(\"beautiful\")"
         }
        ]
       }
      ]
     },
     "then": [
      {
       "op": "money",
       "amount": "12000"
      },
      {
       "op": "set",
       "path": "fame",
       "value": "clamp((s.fame||0)+18)"
      },
      {
       "op": "set",
       "path": "followers",
       "value": "(s.followers||0)+40000"
      },
      {
       "op": "outcome",
       "tpl": "CAST! Recurring role, $12,000! Fans learn your name!"
      }
     ],
     "else": [
      {
       "op": "outcome",
       "tpl": "Callbacks, maybes, silence. The industry is brutal."
      }
     ]
    }
   ]
  },
  {
   "label": "Crew instead ($2k)",
   "hint": "safe",
   "effects": [
    {
     "op": "money",
     "amount": "2000"
    },
    {
     "op": "outcome",
     "tpl": "You run cables, learn everything, get paid."
    }
   ]
  }
 ]
}