{
 "id": "scam-call",
 "minAge": 60,
 "maxAge": 100,
 "title": "Grandma? It is me",
 "tags": [
  "adult-life",
  "money"
 ],
 "weight": 1,
 "preconditions": null,
 "text": "A wobbling voice calls {{s.firstName}}: It is me — I am in jail, wire $5,000 NOW, do not tell mom!",
 "choices": [
  {
   "label": "Hang up and block",
   "hint": "safe",
   "effects": [
    {
     "op": "stat",
     "key": "karma",
     "delta": "4"
    },
    {
     "op": "outcome",
     "tpl": "{{s.traits&&s.traits.includes(\"paranoid\")?\"Red flags everywhere. Blocked before hello.\":\"You block the number and warn the bingo group. Hero.\"}}"
    }
   ]
  },
  {
   "label": "Waste their time",
   "hint": "karma+, fun",
   "effects": [
    {
     "op": "stat",
     "key": "karma",
     "delta": "6"
    },
    {
     "op": "stat",
     "key": "happiness",
     "delta": "8"
    },
    {
     "op": "outcome",
     "tpl": "Forty minutes of fake confusion. They hang up first. Victory."
    }
   ]
  },
  {
   "label": "Wire the money",
   "hint": "trap!",
   "effects": [
    {
     "op": "branch",
     "cond": {
      "all": [
       {
        "p": "traits",
        "truthy": true
       },
       {
        "expr": "s.traits.includes(\"paranoid\")"
       }
      ]
     },
     "then": [
      {
       "op": "outcome",
       "tpl": "Paranoia saves you at the last digit. You freeze the transfer."
      }
     ],
     "else": [
      {
       "op": "money",
       "amount": "-(5000)"
      },
      {
       "op": "stat",
       "key": "happiness",
       "delta": "-(12)"
      },
      {
       "op": "outcome",
       "tpl": "It was not family. The shame stings worse than the loss."
      }
     ]
    }
   ]
  }
 ]
}