{
 "id": "scholarship-offer",
 "minAge": 17,
 "maxAge": 19,
 "title": "Scholarship letter!",
 "tags": [
  "family",
  "money"
 ],
 "weight": 1,
 "preconditions": null,
 "text": "A university offers a FULL scholarship — if grades hold at 90+. Yours: {{s.education.grades}}.",
 "choices": [
  {
   "label": "Sign & grind",
   "hint": "grades check",
   "effects": [
    {
     "op": "branch",
     "cond": {
      "p": "education.grades",
      "gte": 88
     },
     "then": [
      {
       "op": "set",
       "path": "flags.student",
       "value": "true"
      },
      {
       "op": "set",
       "path": "education.collegeYears",
       "value": "0"
      },
      {
       "op": "set",
       "path": "scholarship",
       "value": "true"
      },
      {
       "op": "set",
       "path": "major",
       "value": "\"General\""
      },
      {
       "op": "outcome",
       "tpl": "SIGNED. Tuition: $0. The library becomes home."
      }
     ],
     "else": [
      {
       "op": "set",
       "path": "education.grades",
       "value": "clamp(s.education.grades+4)"
      },
      {
       "op": "outcome",
       "tpl": "Just short — but the chase lifts your grades."
      }
     ]
    }
   ]
  },
  {
   "label": "Decline, work instead",
   "hint": "money now",
   "effects": [
    {
     "op": "money",
     "amount": "3000"
    },
    {
     "op": "outcome",
     "tpl": "Straight to work. The school of life charges different fees."
    }
   ]
  }
 ]
}