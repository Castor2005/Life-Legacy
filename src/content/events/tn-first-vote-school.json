{
 "id": "tn-first-vote-school",
 "minAge": 15,
 "maxAge": 17,
 "title": "School election",
 "tags": [
  "teen",
  "social"
 ],
 "weight": 1,
 "preconditions": null,
 "text": "Class president. Your speech is Tuesday. The posters are up.",
 "choices": [
  {
   "label": "Run to win",
   "hint": "social+",
   "effects": [
    {
     "op": "branch",
     "cond": {
      "expr": "s.stats.social>50"
     },
     "then": [
      {
       "op": "stat",
       "key": "social",
       "delta": "8"
      },
      {
       "op": "outcome",
       "tpl": "Victory by 30 votes! The gavel is heavier than expected."
      }
     ],
     "else": [
      {
       "op": "stat",
       "key": "social",
       "delta": "3"
      },
      {
       "op": "outcome",
       "tpl": "You lose to a dance campaign. Democracy stings."
      }
     ]
    }
   ]
  },
  {
   "label": "Campaign manager",
   "hint": "smarts+",
   "effects": [
    {
     "op": "stat",
     "key": "smarts",
     "delta": "5"
    },
    {
     "op": "outcome",
     "tpl": "Your candidate wins. The real power: you."
    }
   ]
  }
 ]
}