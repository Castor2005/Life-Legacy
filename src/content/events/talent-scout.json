{
 "id": "talent-scout",
 "minAge": 16,
 "maxAge": 30,
 "title": "A scout is watching",
 "tags": [
  "family",
  "money"
 ],
 "weight": 1,
 "preconditions": null,
 "text": "A talent scout saw you perform and wants a meeting.",
 "choices": [
  {
   "label": "Chase it!",
   "hint": "creativity/looks check",
   "effects": [
    {
     "op": "branch",
     "cond": {
      "all": [
       {
        "expr": "s.stats.creativity+s.stats.looks>110"
       },
       {
        "expr": "rnd()<0.5"
       }
      ]
     },
     "then": [
      {
       "op": "money",
       "amount": "25000"
      },
      {
       "op": "stat",
       "key": "happiness",
       "delta": "15"
      },
      {
       "op": "outcome",
       "tpl": "Signed! First advance: $25,000!"
      }
     ],
     "else": [
      {
       "op": "outcome",
       "tpl": "Meetings, maybes, silence. The industry is brutal."
      }
     ]
    }
   ]
  },
  {
   "label": "Hobby stays hobby",
   "hint": "peace",
   "effects": [
    {
     "op": "stat",
     "key": "happiness",
     "delta": "3"
    },
    {
     "op": "outcome",
     "tpl": "You keep joy unsponsored."
    }
   ]
  }
 ]
}