{
 "id": "bully",
 "minAge": 6,
 "maxAge": 12,
 "title": "Playground bully",
 "tags": [
  "kid",
  "money"
 ],
 "weight": 1,
 "preconditions": null,
 "text": "A bigger kid keeps stealing {{s.firstName}}'s ball and calling names.",
 "choices": [
  {
   "label": "Stand up to them",
   "hint": "fitness/social check",
   "effects": [
    {
     "op": "branch",
     "cond": {
      "any": [
       {
        "p": "stats.fitness",
        "gt": 40
       },
       {
        "p": "stats.social",
        "gt": 45
       }
      ]
     },
     "then": [
      {
       "op": "stat",
       "key": "social",
       "delta": "8"
      },
      {
       "op": "stat",
       "key": "discipline",
       "delta": "5"
      },
      {
       "op": "outcome",
       "tpl": "You face them down. They back off. Respect earned."
      }
     ],
     "else": [
      {
       "op": "stat",
       "key": "happiness",
       "delta": "-(8)"
      },
      {
       "op": "stat",
       "key": "health",
       "delta": "-(4)"
      },
      {
       "op": "outcome",
       "tpl": "It ends in the dirt with a bloody nose. Lesson learned."
      }
     ]
    }
   ]
  },
  {
   "label": "Tell a teacher",
   "hint": "safe+",
   "effects": [
    {
     "op": "stat",
     "key": "social",
     "delta": "3"
    },
    {
     "op": "outcome",
     "tpl": "Teacher intervenes. Bullying stops. Some kids call you snitch."
    }
   ]
  },
  {
   "label": "Learn to fight (gym)",
   "hint": "fitness+",
   "effects": [
    {
     "op": "stat",
     "key": "fitness",
     "delta": "8"
    },
    {
     "op": "outcome",
     "tpl": "Three months of practice. Nobody steals your ball again."
    }
   ]
  }
 ]
}