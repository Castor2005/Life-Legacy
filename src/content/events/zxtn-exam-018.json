{
 "id": "zxtn-exam-018",
 "minAge": 13,
 "maxAge": 17,
 "title": "History orals season",
 "tags": [
  "teen",
  "school"
 ],
 "weight": 1,
 "preconditions": null,
 "text": "Flashcards cover every surface. Luz is stress-highlighting the textbook.",
 "choices": [
  {
   "label": "Grind nightly",
   "hint": "grades+",
   "effects": [
    {
     "op": "set",
     "path": "education.grades",
     "value": "clamp(s.education.grades+(6))"
    },
    {
     "op": "branch",
     "cond": {
      "expr": "s.stats.discipline>50"
     },
     "then": [
      {
       "op": "stat",
       "key": "discipline",
       "delta": "3"
      }
     ],
     "else": [
      {
       "op": "stat",
       "key": "stress",
       "delta": "7"
      }
     ]
    },
    {
     "op": "outcome",
     "tpl": "History orals conquered. Luz owes you one for the notes."
    }
   ]
  },
  {
   "label": "Study with Luz",
   "hint": "social+",
   "effects": [
    {
     "op": "stat",
     "key": "social",
     "delta": "4"
    },
    {
     "op": "set",
     "path": "education.grades",
     "value": "clamp(s.education.grades+(3))"
    },
    {
     "op": "outcome",
     "tpl": "Half studying, half laughing. History orals still goes fine."
    }
   ]
  }
 ]
}