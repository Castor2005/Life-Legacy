{
 "id": "ow-willing-oath",
 "minAge": 18,
 "maxAge": 60,
 "title": "'I choose it'",
 "tags": [
  "adult-life",
  "sex",
  "ownership",
  "love"
 ],
 "weight": 1,
 "preconditions": {
  "all": [
   {
    "all": [
     {
      "all": [
       {
        "p": "sex",
        "truthy": true
       },
       {
        "p": "sex.claims",
        "truthy": true
       }
      ]
     },
     {
      "p": "sex.claims.length",
      "truthy": true
     }
    ]
   },
   {
    "some": {
     "arr": "sex.claims",
     "where": {
      "p": "$it.obsession",
      "gte": 55
     }
    }
   }
  ]
 },
 "text": {
  "lets": [
   {
    "name": "cs",
    "expr": "s.sex&&s.sex.claims||[]"
   },
   {
    "name": "h",
    "expr": "whereLast(cs,\"obsession\",\"gte\",60)"
   },
   {
    "name": "c",
    "expr": "h||cs[cs.length-1]"
   },
   {
    "name": "n",
    "expr": "c?c.name:\"your lover\""
   },
   {
    "name": "ob",
    "expr": "c?c.obsession:0"
   }
  ],
  "template": "{{n}} (obsession {{ob}}) kneels without being told, collar in their own hands: 'No papers. No games. I have thought for months — I want to be yours because I say so.'"
 },
 "choices": [
  {
   "label": "Accept their oath",
   "hint": "willing, devoted path",
   "effects": [
    {
     "op": "let",
     "name": "c",
     "expr": "topBy(s.sex.claims,\"obsession\")"
    },
    {
     "op": "let",
     "name": "nm",
     "expr": "c.name"
    },
    {
     "op": "setv",
     "target": "c",
     "path": "accepted",
     "value": "true"
    },
    {
     "op": "setv",
     "target": "c",
     "path": "mode",
     "value": "\"willing\""
    },
    {
     "op": "setv",
     "target": "c",
     "path": "own",
     "value": "clamp(c.own+16)"
    },
    {
     "op": "setv",
     "target": "c",
     "path": "obedience",
     "value": "clamp(c.obedience+10)"
    },
    {
     "op": "setv",
     "target": "c",
     "path": "obsession",
     "value": "clamp(c.obsession+12)"
    },
    {
     "op": "setv",
     "target": "c",
     "path": "stage",
     "value": "max(c.stage,2)"
    },
    {
     "op": "branch",
     "cond": {
      "all": [
       {
        "v": "c.obedience",
        "gte": 95
       },
       {
        "v": "c.obsession",
        "gte": 80
       }
      ]
     },
     "then": [
      {
       "op": "setv",
       "target": "c",
       "path": "stage",
       "value": "4"
      }
     ]
    },
    {
     "op": "histLog",
     "name": "nm",
     "acts": [
      "\"tender\"",
      "\"worship\""
     ]
    },
    {
     "op": "stat",
     "key": "karma",
     "delta": "4"
    },
    {
     "op": "stat",
     "key": "happiness",
     "delta": "12"
    },
    {
     "op": "branch",
     "cond": {
      "all": [
       {
        "partner": "exists"
       },
       {
        "expr": "s.relationships.partner.name===nm"
       }
      ]
     },
     "then": [
      {
       "op": "partnerRel",
       "delta": "12"
      }
     ]
    },
    {
     "op": "outcome",
     "tpl": "You fasten what they hand you, then worship them back — mouths, slow fucking, cumming together while they whisper your name like a vow. ACCEPTED (own {{c.own}}, stage {{c.stage}}). This one will never need breaking."
    }
   ]
  },
  {
   "label": "Ask for a year first",
   "hint": "patience",
   "effects": [
    {
     "op": "let",
     "name": "c2",
     "expr": "topBy(s.sex.claims,\"obsession\")"
    },
    {
     "op": "setv",
     "target": "c2",
     "path": "obsession",
     "value": "clamp(c2.obsession+6)"
    },
    {
     "op": "stat",
     "key": "discipline",
     "delta": "5"
    },
    {
     "op": "stat",
     "key": "karma",
     "delta": "6"
    },
    {
     "op": "outcome",
     "tpl": "You kiss their forehead and wait. '{{c2.name}} — ask me again in a year, sober, and I will carve the answer in stone.' They glow for weeks."
    }
   ]
  }
 ]
}