{
 "id": "kid-talent",
 "minAge": 22,
 "maxAge": 60,
 "title": "Stage lights",
 "tags": [
  "adult-life",
  "family"
 ],
 "weight": 1,
 "preconditions": {
  "some": {
   "arr": "relationships.children",
   "where": {
    "all": [
     {
      "p": "$it.age",
      "gte": 8
     },
     {
      "p": "$it.age",
      "lte": 14
     }
    ]
   }
  }
 },
 "text": {
  "lets": [
   {
    "name": "k",
    "expr": "where(whereAll(s.relationships.children||[],\"age\",\"gte\",8),\"age\",\"lte\",14)"
   }
  ],
  "template": "{{k?k.name+\" (\"+(k&&k.dream?\"future \"+k.dream:\"big dreams\")+\")\":\"Your kid\"}} made the talent-show finals and is vibrating with nerves."
 },
 "choices": [
  {
   "label": "Front row, loudest cheer",
   "hint": "rel+",
   "effects": [
    {
     "op": "let",
     "name": "k",
     "expr": "where(whereAll(s.relationships.children,\"age\",\"gte\",8),\"age\",\"lte\",14)"
    },
    {
     "op": "branch",
     "cond": {
      "v": "k",
      "truthy": true
     },
     "then": [
      {
       "op": "setv",
       "target": "k",
       "path": "rel",
       "value": "clamp(k.rel+7)"
      }
     ]
    },
    {
     "op": "stat",
     "key": "happiness",
     "delta": "6"
    },
    {
     "op": "outcome",
     "tpl": "They scan the crowd, find you, and shine twice as bright."
    }
   ]
  },
  {
   "label": "Grades first, stage later",
   "hint": "grades+, rel-",
   "effects": [
    {
     "op": "let",
     "name": "k",
     "expr": "where(whereAll(s.relationships.children,\"age\",\"gte\",8),\"age\",\"lte\",14)"
    },
    {
     "op": "branch",
     "cond": {
      "v": "k",
      "truthy": true
     },
     "then": [
      {
       "op": "setv",
       "target": "k",
       "path": "grades",
       "value": "clamp(k.grades+5)"
      },
      {
       "op": "setv",
       "target": "k",
       "path": "rel",
       "value": "clamp(k.rel-3)"
      }
     ]
    },
    {
     "op": "outcome",
     "tpl": "Practice between chapters. Both improve, unevenly."
    }
   ]
  }
 ]
}