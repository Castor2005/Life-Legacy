       "tpl": "Bluff called — there was nothing. They slink off."
      }
     ],
     "else": [
      {
       "op": "money",
       "amount": "-(2000)"
      },
      {
       "op": "stat",
       "key": "happiness",
       "delta": "-(8)"
      },
      {
       "op": "outcome",
       "tpl": "It was real. You pay double, learn opsec."
      }
     ]
    }
   ]
  },
  {
   "label": "Go to police",
   "hint": "lawful",
   "effects": [
    {
     "op": "stat",
     "key": "karma",
     "delta": "6"
    },
    {
     "op": "outcome",
