      "any": [
       {
        "any": [
         {
          "all": [
           {
            "p": "traits",
            "truthy": true
           },
           {
            "expr": "s.traits.includes(\"brave\")"
           }
          ]
         },
         {
          "all": [
           {
            "p": "traits",
            "truthy": true
           },
           {
            "expr": "s.traits.includes(\"paranoid\")"
           }
          ]
         }
        ]
       },
       {
        "expr": "rnd()<0.6"
       }
      ]
     },
     "then": [
      {
       "op": "stat",
       "key": "karma",
       "delta": "4"
      },
      {
