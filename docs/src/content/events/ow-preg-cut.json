{
 "id": "ow-preg-cut",
 "minAge": 20,
 "maxAge": 42,
 "title": "Control the seed",
 "tags": [
  "adult-life",
  "sex",
  "ownership",
  "love",
  "money"
 ],
 "weight": 1,
 "preconditions": {
  "all": [
   {
    "p": "sex",
    "truthy": true
   },
   {
    "any": [
     {
      "p": "sex.protection",
      "eq": false
     },
     {
      "p": "sex.pregScares",
      "gte": 1
     }
    ]
   }
  ]
 },
 "text": "Raw nights, fertile bodies, no safety net. The scare count sits at {{s.sex&&s.sex.pregScares||0}} — the next one might stick.",
 "choices": [
  {
   "label": "Lock it down",
   "hint": "protection ON",
   "effects": [
    {
     "op": "money",
     "amount": "-(150)"
    },
    {
     "op": "protection",
     "bool": true
    },
    {
     "op": "forClaims",
     "idxAs": "i",
     "body": [
      {
       "op": "branch",
       "cond": {
        "expr": "s.sex.claims[i].preg.state===\"none\""
       },
       "then": [
        {
         "op": "claimPath",
         "ref": "$it",
         "path": "preg.state",
         "value": "\"prevented\""
        },
        {
         "op": "claimPath",
         "ref": "$it",
         "path": "preg.ctrl",
         "value": "\"prevented\""
        }
       ]
      }
     ]
    },
    {
     "op": "stat",
     "key": "happiness",
     "delta": "-(2)"
    },
    {
     "op": "outcome",
     "tpl": "Condoms, pills, calendar, discipline $150. Every owned partner marked PREVENTED. The seed obeys now."
    }
   ]
  },
  {
   "label": "Trust fate raw",
   "hint": "accidental gamble",
   "effects": [
    {
     "op": "let",
     "name": "n",
     "expr": "s.relationships.partner?s.relationships.partner.name:s.sex.lovers[s.sex.lovers.length-1]||randName()"
    },
    {
     "op": "call",
     "fn": "sex.preg",
     "as": "pr",
     "args": {
      "name": {
       "expr": "n"
      },
      "mult": {
       "expr": "1.2"
      },
      "ctrl": {
       "expr": "\"accidental\""
      }
     }
    },
    {
     "op": "branch",
     "cond": {
      "expr": "pr.indexOf(\"born\")===0"
     },
     "then": [
      {
       "op": "outcome",
       "tpl": "You trust fate raw — and {{pr.slice(5)}} arrives anyway, conceived ACCIDENTAL. Fate fucks back."
      }
     ],
     "else": [
      {
       "op": "pregScares"
      },
      {
       "op": "outcome",
       "tpl": "Lucky. Late stress, not a baby. The 4% missed. This time."
      }
     ]
    }
   ]
  }
 ]
}