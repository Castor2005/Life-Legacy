{
 "id": "ow-break-stolen",
 "minAge": 21,
 "maxAge": 60,
 "title": "Unmake the stolen",
 "tags": [
  "adult-life",
  "sex",
  "ownership"
 ],
 "weight": 1,
 "preconditions": {
  "all": [
   {
    "p": "sex",
    "truthy": true
   },
   {
    "any": [
     {
      "all": [
       {
        "p": "sex.netori",
        "truthy": true
       },
       {
        "p": "sex.netori.taken",
        "gte": 1
       }
      ]
     },
     {
      "all": [
       {
        "p": "sex.claims",
        "truthy": true
       },
       {
        "p": "sex.claims.length",
        "gte": 1
       }
      ]
     }
    ]
   }
  ]
 },
 "text": {
  "lets": [
   {
    "name": "cs",
    "expr": "s.sex&&s.sex.claims||[]"
   },
   {
    "name": "b",
    "expr": "where(cs,\"mode\",\"eq\",\"broken\")||cs[cs.length-1]"
   },
   {
    "name": "n",
    "expr": "b?b.name:\"the stolen one\""
   },
   {
    "name": "w",
    "expr": "b?b.broken:0"
   }
  ],
  "template": "The one you stole ({{n}}, will {{w}} ground) still answers their old spouse's calls. Still flinches at the ring tone. You decide tonight whether the old life dies."
 },
 "choices": [
  {
   "label": "Break the old ties",
   "hint": "broken+, own+",
   "effects": [
    {
     "op": "let",
     "name": "c",
     "expr": "s.sex.claims[s.sex.claims.length-1]"
    },
    {
     "op": "let",
     "name": "nm",
     "expr": "c.name"
    },
    {
     "op": "setv",
     "target": "c",
     "path": "broken",
     "value": "clamp(c.broken+22)"
    },
    {
     "op": "setv",
     "target": "c",
     "path": "obedience",
     "value": "clamp(c.obedience+14)"
    },
    {
     "op": "setv",
     "target": "c",
     "path": "obsession",
     "value": "clamp(c.obsession+10)"
    },
    {
     "op": "setv",
     "target": "c",
     "path": "own",
     "value": "clamp(c.own+12)"
    },
    {
     "op": "setv",
     "target": "c",
     "path": "mode",
     "value": "\"broken\""
    },
    {
     "op": "branch",
     "cond": {
      "any": [
       {
        "v": "c.broken",
        "gte": 70
       },
       {
        "v": "c.obedience",
        "gte": 85
       }
      ]
     },
     "then": [
      {
       "op": "setv",
       "target": "c",
       "path": "stage",
       "value": "max(c.stage,3)"
      }
     ]
    },
    {
     "op": "histLog",
     "name": "nm",
     "acts": [
      "\"rough\"",
      "\"bondage\""
     ]
    },
    {
     "op": "corr",
     "delta": "10"
    },
    {
     "op": "stat",
     "key": "karma",
     "delta": "-(10)"
    },
    {
     "op": "stat",
     "key": "happiness",
     "delta": "8"
    },
    {
     "op": "outcome",
     "tpl": "Phone smashed. Photos burned. New collar, new name for them in your mouth, new rules fucked into memory till they cum chanting belonging. {{nm}} is unmade and remade (will {{c.broken}}, own {{c.own}})."
    }
   ]
  },
  {
   "label": "Cut them loose",
   "hint": "karma+",
   "effects": [
    {
     "op": "claimPop",
     "as": "c2"
    },
    {
     "op": "stat",
     "key": "karma",
     "delta": "10"
    },
    {
     "op": "stat",
     "key": "happiness",
     "delta": "-(6)"
    },
    {
     "op": "outcome",
     "tpl": "You hand {{c2?c2.name:\"them\"}} the train fare and the truth: 'You were stolen, not kept.' They cry all the way home. Clean. Aching."
    }
   ]
  }
 ]
}