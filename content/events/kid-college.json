{
 "id": "kid-college",
 "minAge": 35,
 "maxAge": 70,
 "title": "The thick envelope",
 "tags": [
  "adult-life",
  "family",
  "money"
 ],
 "weight": 1,
 "preconditions": {
  "some": {
   "arr": "relationships.children",
   "where": {
    "p": "$it.age",
    "eq": 18
   }
  }
 },
 "text": {
  "lets": [
   {
    "name": "k",
    "expr": "where(s.relationships.children||[],\"age\",\"eq\",18)"
   }
  ],
  "template": "{{k?k.name:\"Your graduate\"}} holds a thick envelope with a university crest. Hands shaking."
 },
 "choices": [
  {
   "label": "Celebrate whatever it says",
   "hint": "rel+",
   "effects": [
    {
     "op": "let",
     "name": "k",
     "expr": "where(s.relationships.children,\"age\",\"eq\",18)"
    },
    {
     "op": "branch",
     "cond": {
      "v": "k",
      "truthy": true
     },
     "then": [
      {
       "op": "setv",
       "target": "k",
       "path": "rel",
       "value": "clamp(k.rel+8)"
      },
      {
       "op": "setv",
       "target": "k",
       "path": "grades",
       "value": "clamp(k.grades+3)"
      }
     ]
    },
    {
     "op": "stat",
     "key": "happiness",
     "delta": "8"
    },
    {
     "op": "money",
     "amount": "-(200)",
     "floor": 0
    },
    {
     "op": "outcome",
     "tpl": "{{k&&k.grades>=70?\"ACCEPTED! Screaming, cake, phone calls till midnight.\":\"Waitlisted — but the hug is full-size. Plans forming.\"}}"
    }
   ]
  },
  {
   "label": "Count the cost first",
   "hint": "rel-",
   "effects": [
    {
     "op": "let",
     "name": "k",
     "expr": "where(s.relationships.children,\"age\",\"eq\",18)"
    },
    {
     "op": "branch",
     "cond": {
      "v": "k",
      "truthy": true
     },
     "then": [
      {
       "op": "setv",
       "target": "k",
       "path": "rel",
       "value": "clamp(k.rel-5)"
      }
     ]
    },
    {
     "op": "outcome",
     "tpl": "Tuition math at the kitchen table. Dreams, itemized."
    }
   ]
  }
 ]
}