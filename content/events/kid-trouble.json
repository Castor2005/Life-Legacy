    },
    {
     "op": "outcome",
     "tpl": "A long walk, hard truths, a hug. They turn a corner."
    }
   ]
  },
  {
   "label": "Ground for a month",
   "hint": "—",
   "effects": [
    {
     "op": "set",
     "path": "relationships.children.0.rel",
     "value": "clamp(s.relationships.children[0].rel-10)"
    },
    {
     "op": "outcome",
     "tpl": "Silence. Then slow thaw."
    }
   ]
  }
 ]
