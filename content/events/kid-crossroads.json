{
 "id": "kid-crossroads",
 "minAge": 35,
 "maxAge": 70,
 "title": "What should I be?",
 "tags": [
  "adult-life",
  "family",
  "money"
 ],
 "weight": 1,
 "preconditions": {
  "some": {
   "arr": "relationships.children",
   "where": {
    "all": [
     {
      "p": "$it.age",
      "gte": 18
     },
     {
      "p": "$it.age",
      "lte": 24
     }
    ]
   }
  }
 },
 "text": {
  "lets": [
   {
    "name": "k",
    "expr": "where(whereAll(s.relationships.children||[],\"age\",\"gte\",18),\"age\",\"lte\",24)"
   }
  ],
  "template": "{{k?k.name+\" (\"+(k.trait||\"young\")+\", wants \"+(k.dream||\"everything\")+\")\":\"Your grown kid\"}} asks the big one over dinner: 'What should I do with my life?'"
 },
 "choices": [
  {
   "label": "Bless the dream",
   "hint": "rel+",
   "effects": [
    {
     "op": "let",
     "name": "k",
     "expr": "where(whereAll(s.relationships.children,\"age\",\"gte\",18),\"age\",\"lte\",24)"
    },
    {
     "op": "branch",
     "cond": {
      "v": "k",
      "truthy": true
     },
     "then": [
      {
       "op": "setv",
       "target": "k",
       "path": "rel",
       "value": "clamp(k.rel+7)"
      }
     ]
    },
    {
     "op": "stat",
     "key": "happiness",
     "delta": "3"
    },
    {
     "op": "outcome",
     "tpl": "'Then go be it brilliantly.' They exhale like they've held that breath for years."
    }
   ]
  },
  {
   "label": "Push the practical",
   "hint": "rel-, money+",
   "effects": [
    {
     "op": "let",
     "name": "k",
     "expr": "where(whereAll(s.relationships.children,\"age\",\"gte\",18),\"age\",\"lte\",24)"
    },
    {
     "op": "branch",
     "cond": {
      "v": "k",
      "truthy": true
     },
     "then": [
      {
       "op": "setv",
       "target": "k",
       "path": "rel",
       "value": "clamp(k.rel-4)"
      }
     ]
    },
    {
     "op": "money",
     "amount": "800"
    },
    {
     "op": "outcome",
     "tpl": "Contacts called, internship secured. Gratitude, delayed."
    }
   ]
  }
 ]
}