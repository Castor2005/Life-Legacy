{
 "id": "debate-team",
 "minAge": 14,
 "maxAge": 17,
 "title": "Debate coach notices",
 "tags": [
  "teen",
  "status",
  "money"
 ],
 "weight": 1,
 "preconditions": null,
 "text": "The debate coach watched {{s.firstName}} argue about cafeteria portions and smelled potential.",
 "choices": [
  {
   "label": "Join and compete",
   "hint": "smarts check",
   "effects": [
    {
     "op": "branch",
     "cond": {
      "p": "stats.smarts",
      "gt": 50
     },
     "then": [
      {
       "op": "set",
       "path": "education.grades",
       "value": "clamp(s.education.grades+5)"
      },
      {
       "op": "stat",
       "key": "social",
       "delta": "7"
      },
      {
       "op": "set",
       "path": "prestige",
       "value": "(s.prestige||0)+8"
      },
      {
       "op": "outcome",
       "tpl": "Trophies and terrifying rebuttals. College apps glow."
      }
     ],
     "else": [
      {
       "op": "stat",
       "key": "smarts",
       "delta": "4"
      },
      {
       "op": "outcome",
       "tpl": "First tournament: crushed. Second: less crushed."
      }
     ]
    }
   ]
  },
  {
   "label": "Pass",
   "hint": "—",
   "effects": [
    {
     "op": "outcome",
     "tpl": "You keep opinions recreational."
    }
   ]
  }
 ]
}