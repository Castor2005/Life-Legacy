{
 "id": "tn-school-play-lead",
 "minAge": 13,
 "maxAge": 17,
 "title": "Lead role shot",
 "tags": [
  "teen",
  "creativity"
 ],
 "weight": 1,
 "preconditions": null,
 "text": "Auditions for the spring play. The lead has 200 lines.",
 "choices": [
  {
   "label": "Audition all-in",
   "hint": "creativity+",
   "effects": [
    {
     "op": "branch",
     "cond": {
      "expr": "s.stats.creativity>50"
     },
     "then": [
      {
       "op": "stat",
       "key": "creativity",
       "delta": "8"
      },
      {
       "op": "outcome",
       "tpl": "The part is yours. Opening night: tears, applause, flowers."
      }
     ],
     "else": [
      {
       "op": "stat",
       "key": "creativity",
       "delta": "4"
      },
      {
       "op": "outcome",
       "tpl": "Ensemble instead. You steal every scene you are in."
      }
     ]
    }
   ]
  },
  {
   "label": "Run lights",
   "hint": "smarts+",
   "effects": [
    {
     "op": "stat",
     "key": "smarts",
     "delta": "5"
    },
    {
     "op": "outcome",
     "tpl": "Lighting design becomes your art. The show glows because of you."
    }
   ]
  }
 ]
}