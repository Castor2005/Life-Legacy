{
 "id": "kid-care",
 "minAge": 60,
 "maxAge": 100,
 "title": "The reversed hands",
 "tags": [
  "adult-life",
  "family"
 ],
 "weight": 1,
 "preconditions": {
  "some": {
   "arr": "relationships.children",
   "where": {
    "all": [
     {
      "p": "$it.age",
      "gte": 20
     },
     {
      "p": "$it.rel",
      "gt": 60
     }
    ]
   }
  }
 },
 "text": {
  "lets": [
   {
    "name": "k",
    "expr": "where(whereAll(s.relationships.children||[],\"age\",\"gte\",20),\"rel\",\"gt\",60)"
   }
  ],
  "template": "{{k?k.name:\"Your child\"}} starts showing up with groceries, then with schedules, then with That Look doctors get."
 },
 "choices": [
  {
   "label": "Accept the care",
   "hint": "health+",
   "effects": [
    {
     "op": "stat",
     "key": "health",
     "delta": "4"
    },
    {
     "op": "stat",
     "key": "happiness",
     "delta": "5"
    },
    {
     "op": "outcome",
     "tpl": "Soup appears. Appointments get kept. Love, reversed, tastes wonderful."
    }
   ]
  },
  {
   "label": "Insist you're fine",
   "hint": "stubborn",
   "effects": [
    {
     "op": "stat",
     "key": "health",
     "delta": "-(2)"
    },
    {
     "op": "stat",
     "key": "happiness",
     "delta": "2"
    },
    {
     "op": "stat",
     "key": "discipline",
     "delta": "3"
    },
    {
     "op": "outcome",
     "tpl": "You hide the pill organizer. They find it. Everybody pretends."
    }
   ]
  }
 ]
}