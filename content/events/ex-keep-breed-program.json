{
 "id": "ex-keep-breed-program",
 "minAge": 22,
 "maxAge": 42,
 "title": "The breeding program",
 "tags": [
  "adult-life",
  "sex",
  "extreme",
  "money"
 ],
 "weight": 1,
 "preconditions": {
  "all": [
   {
    "all": [
     {
      "p": "sex",
      "truthy": true
     },
     {
      "p": "sex.claims",
      "truthy": true
     }
    ]
   },
   {
    "p": "sex.claims.length",
    "gte": 2
   }
  ]
 },
 "text": {
  "lets": [
   {
    "name": "n",
    "expr": "s.sex&&s.sex.claims&&s.sex.claims.length||0"
   }
  ],
  "template": "Fertile week. {{n}} owned wombs, one owner seed. The calendar on the fridge marks temperatures in red: 'FILL US,' it says in three handwritings."
 },
 "choices": [
  {
   "label": "Run the program raw",
   "hint": "FORCED preg program",
   "effects": [
    {
     "op": "protection",
     "bool": false
    },
    {
     "op": "let",
     "name": "made",
     "expr": "[]"
    },
    {
     "op": "forClaims",
     "idxAs": "i",
     "body": [
      {
       "op": "let",
       "name": "nm",
       "expr": "s.sex.claims[i].name"
      },
      {
       "op": "histLog",
       "name": "nm",
       "acts": [
        "\"rough\"",
        "\"vanilla\""
       ]
      },
      {
       "op": "call",
       "fn": "sex.preg",
       "as": "pr",
       "args": {
        "name": {
         "expr": "nm"
        },
        "mult": {
         "expr": "2.5"
        },
        "ctrl": {
         "expr": "\"forced\""
        }
       }
      },
      {
       "op": "branch",
       "cond": {
        "expr": "pr.indexOf(\"born\")===0"
       },
       "then": [
        {
         "op": "arrPush",
         "target": "made",
         "value": "pr.slice(5)"
        }
       ],
       "else": [
        {
         "op": "claimPath",
         "ref": "$it",
         "path": "preg.state",
         "value": "\"pregnant\""
        },
        {
         "op": "claimPath",
         "ref": "$it",
         "path": "preg.ctrl",
         "value": "\"forced\""
        },
        {
         "op": "arrPush",
         "target": "made",
         "value": "nm+\" seeded\""
        }
       ]
      }
     ]
    },
    {
     "op": "stat",
     "key": "karma",
     "delta": "-(14)"
    },
    {
     "op": "stat",
     "key": "happiness",
     "delta": "14"
    },
    {
     "op": "scandal",
     "delta": "16"
    },
    {
     "op": "outcome",
     "tpl": "Nightly rounds, tracked and filled: {{made.join(\"; \")}}. The harem counts months together. Dynasty by program."
    }
   ]
  },
  {
   "label": "Vet visit together",
   "hint": "prevented all",
   "effects": [
    {
     "op": "protection",
     "bool": true
    },
    {
     "op": "money",
     "amount": "-(400)"
    },
    {
     "op": "forClaims",
     "idxAs": "j",
     "body": [
      {
       "op": "claimPath",
       "ref": "$it",
       "path": "preg.state",
       "value": "\"prevented\""
      },
      {
       "op": "claimPath",
       "ref": "$it",
       "path": "preg.ctrl",
       "value": "\"prevented\""
      }
     ]
    },
    {
     "op": "outcome",
     "tpl": "Clinic day $400: everyone stocked, tracked, safe. The fridge calendar comes down. Control."
    }
   ]
  }
 ]
}