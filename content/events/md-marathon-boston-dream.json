     "cond": {
      "expr": "s.stats.fitness>60"
     },
     "then": [
      {
       "op": "stat",
       "key": "fitness",
       "delta": "9"
      },
      {
       "op": "outcome",
       "tpl": "Qualified! The jacket fits like destiny."
      }
     ],
     "else": [
      {
       "op": "stat",
       "key": "fitness",
       "delta": "5"
      },
      {
       "op": "outcome",
       "tpl": "Missed by ninety seconds. Next cycle: yours."
      }
     ]
    }
   ]
  },
  {
   "label": "Run for joy",
   "hint": "happiness+",
   "effects": [
    {
     "op": "stat",
     "key": "happiness",
     "delta": "7"
    },
    {
     "op": "outcome",
     "tpl": "No watch, all views. Running remembered as play."
    }
   ]
  }
 ]
}