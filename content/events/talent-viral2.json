{
 "id": "talent-viral2",
 "minAge": 18,
 "maxAge": 50,
 "title": "Boss notices you",
 "tags": [
  "adult-life",
  "money"
 ],
 "weight": 1,
 "preconditions": {
  "all": [
   {
    "job": "employed"
   },
   {
    "p": "jobId",
    "ne": "unemployed"
   }
  ]
 },
 "text": "The big boss watched your project. 'Impressive,' they say. 'Coffee tomorrow?'",
 "choices": [
  {
   "label": "Seize it",
   "hint": "career",
   "effects": [
    {
     "op": "branch",
     "cond": {
      "p": "performance",
      "gt": 50
     },
     "then": [
      {
       "op": "set",
       "path": "salary",
       "value": "round(s.salary*1.15)"
      },
      {
       "op": "outcome",
       "tpl": "Mentored by the top! Raise to ${{s.salary}}!"
      }
     ],
     "else": [
      {
       "op": "stat",
       "key": "social",
       "delta": "4"
      },
      {
       "op": "outcome",
       "tpl": "Good chat. Seeds planted."
      }
     ]
    }
   ]
  },
  {
   "label": "Play it cool",
   "hint": "—",
   "effects": [
    {
     "op": "outcome",
     "tpl": "You nod. The moment passes."
    }
   ]
  }
 ]
}