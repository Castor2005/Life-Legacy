{
 "id": "tn-math-olympiad",
 "minAge": 13,
 "maxAge": 17,
 "title": "Math olympiad",
 "tags": [
  "teen",
  "school"
 ],
 "weight": 1,
 "preconditions": null,
 "text": "The invitational: five problems, three hours, silence.",
 "choices": [
  {
   "label": "Train proofs",
   "hint": "smarts+",
   "effects": [
    {
     "op": "branch",
     "cond": {
      "expr": "s.stats.smarts>55"
     },
     "then": [
      {
       "op": "set",
       "path": "education.grades",
       "value": "clamp(s.education.grades+(6))"
      },
      {
       "op": "stat",
       "key": "smarts",
       "delta": "6"
      },
      {
       "op": "outcome",
       "tpl": "Honorable mention. The certificate goes on the fridge."
      }
     ],
     "else": [
      {
       "op": "stat",
       "key": "smarts",
       "delta": "3"
      },
      {
       "op": "outcome",
       "tpl": "Two solved fully. The third haunts you pleasantly."
      }
     ]
    }
   ]
  },
  {
   "label": "Team round focus",
   "hint": "social+",
   "effects": [
    {
     "op": "stat",
     "key": "social",
     "delta": "5"
    },
    {
     "op": "outcome",
     "tpl": "Your team places. Collaboration points: max."
    }
   ]
  }
 ]
}